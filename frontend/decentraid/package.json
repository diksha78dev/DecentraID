{
  "name": "decentraid-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DecentraID - Blockchain-backed digital identity and credential verification prototype (frontend)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:flow && npm run test:render",
    "test:flow": "esbuild scripts/acceptance-test.mjs --bundle --format=esm --platform=node --define:import.meta.env={\\\"VITE_USE_MOCK\\\":\\\"true\\\"} --outfile=.test-build/flow.mjs --log-level=error && node .test-build/flow.mjs",
    "test:render": "esbuild scripts/render-test.jsx --bundle --format=esm --platform=node --jsx=automatic --define:import.meta.env={\\\"VITE_USE_MOCK\\\":\\\"true\\\"} --external:jsdom --outfile=.test-build/render-bundle.mjs --log-level=error && node scripts/jsdom-runner.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.9",
    "esbuild": "^0.21.5"
  }
}
