# Copy to .env and adjust. Never commit .env.

# Base URL of the Spring Boot REST API.
VITE_API_BASE_URL=http://localhost:8080/api

# "true"  -> mock mode: all requests are served by the in-browser mock API.
# "false" -> real API mode: all requests go to VITE_API_BASE_URL.
VITE_USE_MOCK=true

# Request timeout in milliseconds (real API mode only).
VITE_API_TIMEOUT=15000

# Human readable chain label shown in the UI. Display only.
VITE_CHAIN_NAME=Sepolia Testnet

# Expected EVM chain id (hex). Used to warn when the wallet is on another network.
VITE_CHAIN_ID=0xaa36a7

# Optional block explorer base URL used to link transaction references.
VITE_EXPLORER_BASE_URL=https://sepolia.etherscan.io
